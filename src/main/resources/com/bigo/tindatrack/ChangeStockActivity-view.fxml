<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Increased prefWidth to 70 and prefHeight to 25 to fit the text comfortably -->

<Pane fx:id="changePane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="22.0" prefWidth="50.0" style="-fx-background-radius: 15; -fx-background-color: #b0b0b0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bigo.tindatrack.Controller.StockActivity.StockDetailsControllers.ChangeController.ChangeStockActivityController">
   <children>
      <FontIcon fx:id="increaseIcon" iconColor="#37a345" iconLiteral="mdi2a-arrow-top-right" layoutX="6.0" layoutY="16.0" />
      <FontIcon fx:id="decreaseIcon" iconColor="#d3221e" iconLiteral="mdi2a-arrow-bottom-right" layoutX="6.0" layoutY="16.0" />
      <Label fx:id="detailLabel" layoutX="22.0" layoutY="2.0" minWidth="-Infinity" prefHeight="17.0" prefWidth="26.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold;" text="100">
         <font>
            <Font size="11.0" />
         </font>
      </Label>
   </children>
</Pane>
